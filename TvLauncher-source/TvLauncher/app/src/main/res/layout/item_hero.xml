<?xml version="1.0" encoding="utf-8"?>
<!-- Destaque: 210dp, texto à esquerda, arte à direita com degradês, indicadores no canto direito. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/hero_height"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gArt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gArtFade"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.62" />

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/gArt"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/scrim_hero_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/gArtFade"
        app:layout_constraintStart_toStartOf="@id/gArt"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:background="@drawable/scrim_hero_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/overscan_horizontal"
        android:layout_marginTop="117dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/gArtFade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/heroSource"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/home_label"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="match_parent"
            android:layout_height="33dp"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/home_text_primary"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/heroSubtitle"
            android:layout_width="match_parent"
            android:layout_height="15dp"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/home_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Indicadores, selo e "disponível em", centrados entre si e alinhados à margem direita. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="@dimen/overscan_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.example.tvlauncher.ui.PagerDots
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="4dp" />

        <TextView
            android:id="@+id/heroBadge"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/home_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/heroAvailable"
            android:layout_width="wrap_content"
            android:layout_height="7dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/home_text_secondary"
            android:textSize="6sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
